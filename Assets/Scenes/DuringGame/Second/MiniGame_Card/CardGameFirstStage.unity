  m_Script: {fileID: 11500000, guid: afb2831613cc0184e801e5ed9c78b546, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  k1: "\uC5B4\uB77C\u2026? \uC61B\uB0A0 \uC0DD\uAC01\uB098\uB124. \uC61B\uB0A0\uC5D0
    \uB098\uB3C4 \uC88B\uC544\uD558\uB294 \uB0A8\uC790\uC560\uAC00 \uD65C \uC5F0\uC2B5\uD558\uB294
    \uAC83\uC744 \uBCF4\uB7EC \uC885\uC885 \uBAB0\uB798 \uB098\uAC14\uC5C8\uC9C0.
    \uADF8 \uB4A4 \uC544\uBE60\uD55C\uD14C \uC5C4\uCCAD \uD63C\uC774 \uB0AC\uC9C0\uB9CC\u2026\u2026\u2026.."
  k2: "\u2026.\uC544\uBB34\uB9AC \uBD10\uB3C4 \uB098\uC640 \uB098\uB974\uCF00\uB97C
    \uB2EE\uC558\uC5B4. \uB098\uB974\uCF00\uC758 \uC815\uCCB4\uB294 \uB300\uCCB4
    \uBB50\uC9C0?"
  k3: "\uC9C0\uAE08\uC758 \uB098\uB791 \uB2EE\uC740 \uC800 \uC544\uC774\uC758 \uB9C8\uC74C\u2026
    \uC54C \uAC83 \uAC19\uC544 "
  k4: "\uC548\uB3FC\u2026 "
  k5: "\uC800\uB7F0\u2026 "
  k6: "\uB098\uB974\uCF00\uB294 \uC65C \uB098\uC5D0\uAC8C \uC774\uB7F0 \uAC83\uC744
    \uBCF4\uC5EC\uC900 \uAC78\uAE4C\u2026 "
  j1: "\u3042\u308C\u2026\u2026\uFF1F\u6614\u306E\u3053\u3068\u3092\u601D\u3044\u51FA\u3057\u3061\u3083\u3063\u305F\u2026\u30A2\u30BF\u30B7\u3082\u597D\u304D\u306A\u7537\u306E\u5B50\u304C\u5F13\u306E\u7DF4\u7FD2\u3092\u3057\u3066\u3044\u308B\u306E\u3092\u3001\u3088\u304F\u3053\u3063\u305D\u308A\u898B\u306B\u884C\u3063\u3066\u305F.
    \u305D\u306E\u3042\u3068\u3001\u30D1\u30D1\u306B\u3059\u3054\u304F\u6012\u3089\u308C\u3061\u3083\u3063\u305F\u3051\u3069\u2026\u2026"
  j2: "\u2026\u2026\u3069\u3046\u898B\u3066\u3082\u3001\u30A2\u30BF\u30B7\u3068\u30CA\u30EB\u30B1\u306B\u4F3C\u3066\u308B\u306E\u2026\u30CA\u30EB\u30B1\u3063\u3066\u4E00\u4F53\u8AB0\u2026\u2026\uFF1F"
  j3: "\u4ECA\u306E\u30A2\u30BF\u30B7\u306B\u4F3C\u3066\u308B\u3042\u306E\u5B50\u306E\u6C17\u6301\u3061\u2026\u2026\u308F\u304B\u308B\u6C17\u304C\u3059\u308B..."
  j4: "\u3060\u3081\u2026"
  j5: "\u3042\u3042\u2026\u2026"
  j6: "\u30CA\u30EB\u30B1\u306F\u3069\u3046\u3057\u3066\u30A2\u30BF\u30B7\u306B\u3053\u3093\u306A\u3082\u306E\u3092\u898B\u305B\u305F\u306E\u2026\u2026\uFF1F"
  e1: "Oh\u2026? This reminds me of the old days. I used to sneak out sometimes just
    to see the boy I liked practicing the archery. After that\u2026 Dad really scolded
    me a lot\u2026"
  e2: "No matter how I look at it\u2026 it really looks like me and Narke. I keep
    wondering\u2026 what Narke really is"
  e3: "I think I understand the feelings of that girl\u2026 who\u2019s so much like
    me "
  e4: "No way\u2026 "
  e5: "Oh\u2026"
  e6: "Why did Narke show me something like this\u2026?"
  c1: "\u54A6\u2026\u2026\u8BA9\u6211\u60F3\u8D77\u4E86\u4EE5\u524D\u7684\u4E8B\u3002\u6211\u4EE5\u524D\u4E5F\u5E38\u5E38\u5077\u5077\u8DD1\u53BB\u770B\u559C\u6B22\u7684\u7537\u751F\u7EC3\u7BAD\u3002\u540E\u6765\u88AB\u7238\u7238\u72E0\u72E0\u5730\u9A82\u4E86\u4E00\u987F\u2026\u2026"
  c2: "\u2026\u2026\u600E\u4E48\u770B\u90FD\u50CF\u6211\u548C\u7EB3\u5C14\u514B\u3002\u7EB3\u5C14\u514B\u5230\u5E95\u662F\u4EC0\u4E48\u5462\uFF1F"
  c3: "\u90A3\u4E2A\u548C\u73B0\u5728\u7684 \uB098\u5F88\u50CF\u7684\u5B69\u5B50\u2026\u2026\u6211\u597D\u50CF\u80FD\u7406\u89E3\u5979\u7684\u5FC3\u60C5\u3002"
  c4: "\u4E0D\u884C\u2026\u2026"
  c5: "\u54CE\u5440\u2026\u2026"
  c6: "\u7EB3\u5C14\u514B\u4E3A\u4EC0\u4E48\u8981\u8BA9\u6211\u770B\u5230\u8FD9\u4E9B\u4E1C\u897F\u2026\u2026\uFF1F"
  ka1: "\u041E...? \u0411\u04B1\u043B \u043C\u0430\u0493\u0430\u043D \u0435\u0441\u043A\u0456
    \u043A\u04AF\u043D\u0434\u0435\u0440\u0434\u0456 \u0435\u0441\u043A\u0435 \u0442\u04AF\u0441\u0456\u0440\u0435\u0434\u0456.
    \u0411\u0456\u0440 \u043A\u0435\u0437\u0434\u0435\u0440\u0456 \u043C\u0435\u043D
    \u04E9\u0437\u0456\u043C\u0435 \u04B1\u043D\u0430\u0439\u0442\u044B\u043D \u0431\u0430\u043B\u0430\u043D\u044B
    \u0441\u0430\u0434\u0430\u049B \u0430\u0442\u0443 \u0436\u0430\u0442\u0442\u044B\u0493\u0443\u043B\u0430\u0440\u044B\u043D
    \u043A\u04E9\u0440\u0443 \u04AF\u0448\u0456\u043D \u0436\u0430\u0441\u044B\u0440\u044B\u043D
    \u0448\u044B\u0493\u044B\u043F \u043A\u0435\u0442\u0435\u0442\u0456\u043D\u043C\u0456\u043D.
    \u041E\u0441\u044B\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u04D9\u043A\u0435\u043C
    \u043C\u0435\u043D\u0456 \u049B\u0430\u0442\u0442\u044B \u0441\u04E9\u0433\u0435\u0442\u0456\u043D
    \u0431\u043E\u043B\u0434\u044B\u2026\u2026\u2026\u2026\u2026.."
  ka2: "...\u049A\u0430\u043B\u0430\u0439 \u049B\u0430\u0440\u0430\u0441\u0430\u043C
    \u0434\u0430, \u041D\u0430\u0440\u044B\u043A\u0435 \u0435\u043A\u0435\u0443\u043C\u0456\u0437\u0433\u0435
    \u04B1\u049B\u0441\u0430\u0439\u0434\u044B. \u041D\u0430\u0440\u044B\u043A\u0435\u043D\u0456\u04A3
    \u0448\u044B\u043D \u0442\u04B1\u043B\u0493\u0430\u0441\u044B \u049B\u0430\u043D\u0434\u0430\u0439?"
  ka3: "\u049A\u0430\u0437\u0456\u0440 \u043C\u0430\u0493\u0430\u043D \u04B1\u049B\u0441\u0430\u0439\u0442\u044B\u043D
    \u0441\u043E\u043B \u0431\u0430\u043B\u0430\u043D\u044B\u04A3 \u0441\u0435\u0437\u0456\u043C\u0456\u043D
    \u0442\u04AF\u0441\u0456\u043D\u0434\u0456\u043C \u0434\u0435\u043F \u043E\u0439\u043B\u0430\u0439\u043C\u044B\u043D."
  ka4: "\u0411\u043E\u043B\u043C\u0430\u0439\u0434\u044B\u2026"
  ka5: "\u041E\u043B\u0430\u0439\u2026"
  ka6: "\u041D\u0430\u0440\u044B\u043A\u0435 \u043C\u0430\u0493\u0430\u043D \u043C\u04B1\u043D\u044B
    \u043D\u0435\u0433\u0435 \u043A\u04E9\u0440\u0441\u0435\u0442\u0442\u0456?"
