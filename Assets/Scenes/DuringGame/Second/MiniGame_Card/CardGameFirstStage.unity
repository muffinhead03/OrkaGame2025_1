  - "\u049A\u0430\u0437\u0456\u0440 \u043E\u0439\u044B\u043D \u0431\u0430\u0441\u0442\u0430\u043B\u0430\u0434\u044B~"
  - "\u0415\u0440\u0435\u0436\u0435\u043B\u0435\u0440 \u049B\u0430\u0440\u0430\u043F\u0430\u0439\u044B\u043C!"
  - "\u041E\u04A3 \u0436\u0430\u049B\u0442\u0430 \u043C\u0435\u043D \u0430\u0440\u0430\u043B\u0430\u0441\u0442\u044B\u0440\u0493\u0430\u043D
    \u043A\u0430\u0440\u0442\u0430\u043B\u0430\u0440 \u0436\u0430\u0442\u044B\u0440"
  - "\u0421\u043E\u043B\u0430\u0440\u0434\u044B \u0442\u044B\u0448\u049B\u0430\u043D\u043C\u0435\u043D
    \u04B1\u0441\u0442\u0430\u043F, \u04AF\u0441\u0442\u0435\u043B\u0434\u0456\u04A3
    \u0441\u043E\u043B \u0436\u0430\u0493\u044B\u043D\u0430 \u049B\u043E\u0439"
  - "\u041A\u0430\u0440\u0442\u0430\u0434\u0430\u0493\u044B \u0441\u0443\u0440\u0435\u0442\u043A\u0435
