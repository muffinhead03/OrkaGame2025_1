--- !u!114 &1426955533
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1426955530}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aefc30b138dfb5249bade4733391bfd2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  korean:
  - "\uD6C4\uD6C4 \uB098\uB3C4 \uC5B4\uB9B4 \uB54C \uC800\uB7F0 \uC2DD\uC73C\uB85C
    \uC0AC\uB78C\uB4E4 \uC55E\uC5D0 \uB098\uAC00\uC11C \uB178\uB798\uB97C \uBD80\uB974\uACE0\uB294
    \uD588\uC9C0. \uADF8\uB54C \uBB34\uC2A8 \uC2E0\uC744 \uCC2C\uC591\uD558\uB294
    \uB178\uB798\uC600\uB358 \uAC83 \uAC19\uC740\uB370\u2026 \uC74C \uAE30\uC5B5\uC774
    \uC798 \uC548 \uB098\uB124"
  - " \uC5C7! \uC544\uAE4C\uC640 \uAC19\uC740 \uC0C1\uD669\uC778 \uAC83 \uAC19\uC740\uB370\u2026! "
  - "\uB610 \uAC70\uC808\uB2F9\uD588\uAD6C\uB098\u2026 "
  - "?.. \uC774 \uC5FC\uC18C\uB294 \uB0AF\uC774 \uC775\uC5B4\u2026 \uC124\uB9C8\u2026 "
  - "\u2026"
  - "\uC65C \uB098\uC5D0\uAC8C \uC790\uAFB8 \uC774\uB7F0 \uAC83\uC744 \uBCF4\uC5EC\uC8FC\uB294
    \uAC70\uC57C\u2026"
  japanese:
  - "\u3075\u3075\u3063\u2026\u2026\u30A2\u30BF\u30B7\u3082\u5B50\u3069\u3082\u306E\u3053\u308D\u3001\u3042\u3042\u3084\u3063\u3066\u307F\u3093\u306A\u306E\u524D\u3067\u6B4C\u3063\u305F\u308A\u3057\u3066\u305F\u2026\u306A\u3093\u306E\u795E\u69D8\u3092\u8B83\u3048\u308B\u6B4C\u3060\u3063\u305F\u3088\u3046\u306A...\u3046\u30FC\u3093\u2026\u2026\u3088\u304F\u899A\u3048\u3066\u306A\u3044\u306E\u3088\u306D\u2026"
  - "\u3048\u3063\uFF01\u3055\u3063\u304D\u3068\u540C\u3058\u72B6\u6CC1\u307F\u305F\u3044\u2026\u2026\uFF01"
  - "\u307E\u305F\u65AD\u3089\u308C\u3061\u3083\u3063\u305F\u2026"
  - "\u3048\u3063\u2026\u2026\u3053\u306E\u30E4\u30AE\u3001\u3069\u3053\u304B\u3067\u898B\u305F\u3053\u3068\u304C\u3042\u308B\u6C17\u304C\u3059\u308B\u306E\u2026\u307E\u3055\u304B\u2026\u2026"
  - "\u2026"
  - "\u3069\u3046\u3057\u3066\u30A2\u30BF\u30B7\u306B\u3001\u3053\u3093\u306A\u3082\u306E\u3070\u304B\u308A\u898B\u305B\u308B\u306E\u3088\u2026\u2026\uFF1F"
  english:
  - "Hehe\u2026I used to sing in front of others like that when I was younger. I
    think it was a song praising some kind of god\u2026Hmm\u2026I can\u2019t quite
    recall\u2026"
  - "Wait! I think this is the same situation as before\u2026!"
  - "Another rejection\u2026"
  - "?... This goat looks familiar\u2026Could it be\u2026?\r"
  - "\u2026"
  - "Wh-why do you keep showing me things like this\u2026?"
  chinese:
  - "\u5475\u5475\uFF0C\u6211\u5C0F\u65F6\u5019\u4E5F\u90A3\u6837\u5728\u4EBA\u524D\u5531\u6B4C\u6765\u7740\u3002\u90A3\u65F6\u5019\u597D\u50CF\u662F\u5531\u8D5E\u7F8E\u67D0\u4E2A\u795E\u660E\u7684\u6B4C\u2026\u2026\u55EF\u2026\u2026\u8BB0\u4E0D\u592A\u6E05\u4E86\u3002"
  - "\u54A6\uFF01\u611F\u89C9\u548C\u521A\u624D\u662F\u4E00\u6837\u7684\u60C5\u666F\u2026\u2026\uFF01"
  - "\u53C8\u88AB\u62D2\u7EDD\u4E86\u5417\u2026\u2026"
  - "\u2026\u2026\u8FD9\u53EA\u5C71\u7F8A\uFF0C\u597D\u773C\u719F\u2026\u2026\u96BE\u9053\u662F\u2026\u2026\uFF1F"
  - "\u2026"
  - "\u4F60\u4E3A\u4EC0\u4E48\u4E00\u76F4\u8BA9\u6211\u770B\u8FD9\u4E9B\u4E1C\u897F\u2026\u2026\uFF1F"
  kazakh:
  - "\u0425\u0435\u0445\u0435, \u043C\u0435\u043D \u043A\u0456\u0448\u043A\u0435\u043D\u0442\u0430\u0439
    \u043A\u0435\u0437\u0456\u043C\u0434\u0435 \u0445\u0430\u043B\u044B\u049B\u0442\u044B\u04A3
    \u0430\u043B\u0434\u044B\u043D\u0430 \u0448\u044B\u0493\u044B\u043F, \u043E\u0441\u044B\u043B\u0430\u0439
    \u04D9\u043D. \u0430\u0439\u0442\u0430\u0442\u044B\u043D\u043C\u044B\u043D.\u041C\u0435\u043D\u0456\u04A3
    \u043E\u0439\u044B\u043C\u0448\u0430, \u0431\u04B1\u043B \u04D9\u043B\u0434\u0435\u0431\u0456\u0440
    \u049B\u04B1\u0434\u0430\u0439\u0434\u044B \u043C\u0430\u0434\u0430\u049B\u0442\u0430\u0439\u0442\u044B\u043D
    \u04D9\u043D \u0435\u0434\u0456..\u0425\u043C\u043C, \u0435\u0441\u0456\u043C\u0434\u0435
    \u0436\u043E\u049B.\r\n"
  - "\u041E! \u0411\u04B1\u0440\u044B\u043D\u0493\u044B\u0434\u0430\u0439 \u043A\u04AF\u0439
    \u043A\u0435\u0448\u0435\u0434\u0456... !"
  - "\u0422\u0430\u0493\u044B \u0434\u0430 \u049B\u0430\u0431\u044B\u043B\u0434\u0430\u043D\u0431\u0430\u0434\u044B..."
  - "?... \u041C\u044B\u043D\u0430 \u0435\u0448\u043A\u0456 \u0442\u0430\u043D\u044B\u0441
    \u0441\u0438\u044F\u049B\u0442\u044B...\u041C\u04AF\u043C\u043A\u0456\u043D \u0435\u043C\u0435\u0441..."
  - "\u2026"
  - "\u041D\u0435\u0433\u0435 \u043C\u0430\u0493\u0430\u043D \u043C\u04B1\u043D\u044B
    \u043A\u04E9\u0440\u0441\u0435\u0442\u0435 \u0431\u0435\u0440\u0435\u0441\u0456\u04A3..."
  useFallback: 1
