  m_Script: {fileID: 11500000, guid: fd692f03de89c764ca2307ecbca64a28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  KoreanAbove1_2:
  - "\uC5D0\uCF54"
  - "\uC544\uBE60"
  EnglishAbove1_2:
  - Echo
  - Dad
  JapaneseAbove1_2:
  - "\u30A8\u30B3\u30FC"
  - "\u30D1\u30D1"
  ChineseAbove1_2:
  - "\u827E\u53EF"
  - "\u7238\u7238"
  KazaAbove1_2:
  - "\u042D\u043A\u043E"
  - "\u04D8\u043A\u0435\u0441\u0456"
  KoreanLines1_2:
  - "\uC544\uBE60..."
  - "\uC57C \uC544\uCE68\uC774\uB2E4!"
  - "\uC544\uBE60 \uC624\uB298\uB9CC \uD639\uC2DC \uBC16\uC5D0 \uB098\uAC00\uB3C4
    \uB420\uAE4C\uC694...?"
  - "\uBB34\uC2A8 \uC18C\uB9AC\uB2C8? \uB108\uB294 \uC5EC\uAE30 \uC788\uC5B4\uC57C\uB9CC
    \uD574"
  - "\uBC16\uC740 \uB108\uC5D0\uAC8C \uC704\uD5D8\uD558\uB2E8\uB2E4"
  - "\uC624\uB298 \uBC16\uC5D0\uC11C \uC74C\uC545 \uCD95\uC81C\uB97C \uD558\uB294
    \uAC83 \uAC19\uC740\uB370...2\uB144\uC5D0 1\uBC88 \uC5F4\uB9AC\uB294 \uCD95\uC81C\uB77C
    \uC624\uB298\uC774 \uC544\uB2C8\uBA74 \uADF8"
  - "\uC57C!!! \uC74C\uC545 \uC18C\uB9AC \uD558\uC9C0 \uB9D0\uB7AC\uC9C0 \uB108\uB124
    \uC5C4\uB9C8\uB3C4 \uC74C\uC545\uD558\uB2E4\uAC00 \uADF8 \uAF34 \uB0AC\uB294\uB370"
  - "(\uBB34\uC11C\uC6CC \uD558\uC9C0\uB9CC \uC624\uB298\uC774 \uC544\uB2C8\uBA74...)
    \uC774\uBC88\uC5D0 \uBABB\uAC00\uBA74 \uB2E4\uC2DC\uB294 \uAC08 \uAE30\uD68C\uAC00
    \uC5C6\uC744 \uAC83 \uAC19\uC544\uC694"
  - "\uBD80\uD0C1\uC774\uC5D0\uC694 \uC81C\uBC1C \uC800\uB294 \uACE7... \uC774 \uC138\uC0C1\uC5D0
    \uC5C6\uC744 \uAC83 \uAC19\uB2E4\uACE0\uC694"
  - "\uD5C8..\uC5B5.."
  - "\uADF8\uB534 \uC18C\uB9AC \uB0B4\uAC00 \uD558\uC9C0 \uB9D0\uB7AC\uC9C0! "
  - "\uB10C \uD3C9\uC0DD \uC55E\uC73C\uB85C\uB3C4 \uC601\uC6D0\uD788 \uC5EC\uAE30\uC5D0
    \uC788\uB294\uAC70\uC57C!"
  - "(............., ........, .............) \uD558\uC544....\uD558\uC544..\uC774\uC81C
    \uC880 \uAD1C\uCC2E\uC544\uC9C4 \uAC83 \uAC19\uC544...."
  - "(\uC544\uBE60\uB294 \uC800\uB807\uAC8C \uB9D0\uC500\uD558\uC168\uC9C0\uB9CC...\uC624\uB298\uC774
    \uC544\uB2C8\uBA74 \uC548\uB3FC) \uBB38 \uC7A0\uAE08\uC7A5\uCE58\uB97C \uC0B4\uD3B4\uBCF4\uC790"
  - "\uC548\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uC464\uC154 \uB123\uC73C\uBA74 \uC7A0\uAE08\uC7A5\uCE58\uAC00
    \uC5F4\uB9B4 \uAC83 \uAC19\uC740\uB370..."
  - "\uC544 \uB0B4 \uBA38\uB9AC\uD540\uC73C\uB85C \uD558\uBA74 \uC5F4\uB9B4 \uAC83
    \uAC19\uC544 "
  - "\uD55C\uBC88 \uD574\uBCF4\uC790...!"
  EnglishLines1_2:
  - "Dad\u2026"
  - "Get up! It\u2019s morning!"
  - "Dad, is it okay if I go out today\u2026? Just for today\u2026?"
  - What are you talking about? You must stay here
  - The outside world is dangerous for you
  - "There\u2019s a music festival going on today\u2026 It\u2019s only held once
    every two years\u2026 so if I miss it today\u2026"
  - Hey!!! I told you, No Music! Your mom got messed up because of it!
  - "(I\u2019m scared\u2026 but if not today\u2026) I might never get another chance
    if\u2026"
  - "Please\u2026 I\u2019m begging you\u2026 I really\u2026 feel like I won\u2019t
    be in this world much longer\u2026"
  - "HAh\u2014!\u2026"
  - I told you, no more of that crap!
  - "You\u2019re staying here for life, no matter what!"
  - "(............., ........, .............) Hah\u2026 hah\u2026 I guess I\u2019m
    okay now\u2026"
  - "(Even though Dad said so\u2026 today is the only day) I should check the lock
    on the door"
  - "Maybe if I stick something in there, the lock might open\u2026"
  - "Okay\u2026 let\u2019s try\u2026!"
  - Oh, I think I can use my hairpin to open it
  JapaneseLines1_2:
  - "\u30D1\u30D1\u2026\u2026\r\n"
  - "\u304A\u3044\u3001\u671D\u3060\u305E\uFF01"
  - "\u30D1\u30D1\u2026\u2026\u4ECA\u65E5\u3060\u3051\u3001\u5916\u306B\u51FA\u3066\u3082\u3044\u3044\u306E\u2026\u2026\uFF1F"
  - "\u4F55\u3092\u8A00\u3063\u3066\u308B\u3093\u3060\uFF1F\u304A\u524D\u306F\u3053\u3053\u306B\u3044\u306A\u304D\u3083\u3044\u3051\u306A\u3044\u3093\u3060"
  - "\u5916\u306F\u304A\u524D\u306B\u3068\u3063\u3066\u5371\u967A\u306A\u3093\u3060"
  - "\u4ECA\u65E5\u3001\u5916\u3067\u97F3\u697D\u796D\u3092\u3084\u3063\u3066\u308B\u307F\u305F\u3044\u3067\u2026\u20262\u5E74\u306B1\u56DE\u3057\u304B\u306A\u3044\u304B\u3089\u3001\u4ECA\u65E5\u3058\u3083\u306A\u3044\u3068"
  - "\u304A\u3044\uFF01\uFF01\uFF01\u97F3\u3092\u51FA\u3059\u306A\u3063\u3066\u8A00\u3063\u305F\u3060\u308D\u3002\u304A\u524D\u306E\u6BCD\u3055\u3093\u3082\u97F3\u697D\u306E\u305B\u3044\u3067\u3042\u3093\u306A\u3053\u3068\u306B\u306A\u3063\u305F\u3093\u3060\u305E"
  - "(\u6016\u3044\u3051\u3069\u2026\u2026\u4ECA\u65E5\u3058\u3083\u306A\u304D\u3083\u2026\u2026)
    \u4ECA\u56DE\u884C\u3051\u306A\u304B\u3063\u305F\u3089\u3001\u3082\u3046\u4E8C\u5EA6\u3068\u884C\u3051\u308B\u6642\u304C\u306A\u3044\u6C17\u304C\u3059\u308B\u306E"
  - "\u304A\u9858\u3044\u2026\u2026\u30A2\u30BF\u30B7\u3001\u3082\u3046\u3059\u3050\u2026\u2026\u3053\u306E\u4E16\u754C\u306B\u3044\u306A\u3044\u6C17\u304C\u3059\u308B\u306E\u3088"
  - "\u306F...\u3041\u3063\u2026\u2026"
  - "\u305D\u3093\u306A\u3053\u3068\u8A00\u3046\u306A\u3063\u3066\u3001\u4FFA\u304C\u8A00\u3063\u305F\u3060\u308D\uFF01"
  - "\u304A\u524D\u306F\u4E00\u751F\u3001\u3053\u308C\u304B\u3089\u3082\u305A\u3063\u3068\u3053\u3053\u306B\u3044\u308B\u3093\u3060\uFF01"
  - " (............., ........, .............) \u3041\u2026\u2026\u306F\u3041\u2026\u2026\u5C11\u3057\u3001\u843D\u3061\u7740\u3044...\u305F..."
  - " (\u30D1\u30D1\u306F\u305D\u3046\u8A00\u3063\u305F\u3051\u3069\u2026\u2026\u3084\u3063\u3071\u308A\u4ECA\u65E5\u3058\u3083\u306A\u304D\u3083\u30C0\u30E1\u306A\u306E)
    \u30C9\u30A2\u306E\u30ED\u30C3\u30AF\u3092\u898B\u3066\u307F\u3088\u3046"
  - "\u4E2D\u306B\u4F55\u304B\u3092\u5DEE\u3057\u8FBC\u3081\u3070\u3001\u30C9\u30A2\u304C\u958B\u304D\u305D\u3046"
  - "\u3042\u3042\u3001\u30A2\u30BF\u30B7\u306E\u30D8\u30A2\u30D4\u30F3\u3067\u958B\u3051\u3089\u308C\u305D\u3046\u306A\u6C17\u304C\u3059\u308B"
  - "\u3084\u3063\u3066\u307F\u3088\u3046\u2026\u2026\uFF01"
  ChineseLines1_2:
  - "\u7238\u7238\u2026\u2026"
  - "\u5582\uFF0C\u8D77\u5E8A\u4E86\uFF01"
  - "\u7238\u7238\uFF0C\u4ECA\u5929\u53EF\u4EE5\u8BA9\u6211\u51FA\u53BB\u4E00\u8D9F\u5417\u2026\u2026\uFF1F"
  - "\u4F60\u5728\u8BF4\u4EC0\u4E48\uFF1F\u4F60\u5FC5\u987B\u5F85\u5728\u8FD9\u91CC\u3002 "
  - "\u5916\u9762\u5BF9\u4F60\u6765\u8BF4\u592A\u5371\u9669\u4E86\u3002"
  - "\u5916\u9762\u597D\u50CF\u5728\u4E3E\u884C\u97F3\u4E50\u8282\u2026\u2026\u8FD9\u662F\u4E24\u5E74\u4E00\u6B21\u7684\u8282\u65E5\uFF0C\u4ECA\u5929\u4E0D\u53BB\u7684\u8BDD\u5C31\u2026\u2026"
  - "\u5582\uFF01\uFF01\uFF01\u6211\u4E0D\u662F\u8BF4\u4E86\u522B\u518D\u63D0\u97F3\u4E50\u4E86\u5417\uFF1F\u4F60\u5988\u5988\u4E5F\u662F\u56E0\u4E3A\u97F3\u4E50\u624D\u53D8\u6210\u90A3\u4E2A\u6837\u5B50\u3002"
  - "\uFF08\u597D\u53EF\u6015\u2026\u2026\u4F46\u9519\u8FC7\u4ECA\u5929\u5C31\u771F\u7684\u2026\u2026\uFF09
    \u8FD9\u6B21\u4E0D\u53BB\u7684\u8BDD\uFF0C\u53EF\u80FD\u5C31\u518D\u4E5F\u6CA1\u6709\u673A\u4F1A\u4E86 "
  - "\u62DC\u6258\u4E86\u2026\u2026\u6C42\u4F60\u4E86\u2026\u2026\u6211\u89C9\u5F97\u2026\u2026\u6211\u5FEB\u8981\u4ECE\u8FD9\u4E2A\u4E16\u754C\u4E0A\u6D88\u5931\u4E86\u2026\u2026 "
  - "\u5443\u2026\u2026\u554A\u2026\u2026"
  - "\u522B\u518D\u8BF4\u90A3\u79CD\u9B3C\u8BDD\uFF01 "
  - "\u4F60\u8FD9\u8F88\u5B50\u90FD\u5F97\u6C38\u8FDC\u5F85\u5728\u8FD9\u91CC\uFF01"
  - "\uFF08............., ........, .............)\u54C8\u554A\u2026\u2026\u54C8\u554A\u2026\u2026\u73B0\u5728\u7A0D\u5FAE\u7F13\u8FC7\u6765\u4E00\u70B9\u4E86\u2026\u2026 "
  - "\uFF08\u867D\u7136\u7238\u7238\u662F\u90A3\u4E48\u8BF4\u2026\u2026\u4F46\u4ECA\u5929\u6211\u4E00\u5B9A\u8981\u8FC7\u53BB\uFF09
    \u770B\u770B\u95E8\u9501\u2026\u2026 "
  - "\u4ECE\u91CC\u9762\u585E\u70B9\u4EC0\u4E48\u8FDB\u53BB\u7684\u8BDD\uFF0C\u597D\u50CF\u80FD\u6253\u5F00\u2026\u2026 "
  - " \u554A\uFF0C\u7528\u6211\u7684\u53D1\u5939\u7684\u8BDD\u2026\u2026\u5E94\u8BE5\u53EF\u4EE5"
  - "\u8BD5\u4E00\u8BD5\u5427\u2026\u2026\uFF01"
  KazaLines1_2:
  - "\u04D8\u043A\u0435\u2026"
  - "\u049A\u0430\u0439\u044B\u0440\u043B\u044B \u0442\u0430\u04A3! "
  - "\u04D8\u043A\u0435, \u0431\u04AF\u0433\u0456\u043D \u0434\u0430\u043B\u0430\u0493\u0430
    \u0448\u044B\u049B\u0441\u0430\u043C \u0431\u043E\u043B\u0430 \u043C\u0430? "
  - "\u041D\u0435 \u0434\u044B\u0431\u044B\u0441? \u0421\u0435\u043D \u043E\u0441\u044B\u043D\u0434\u0430
    \u0431\u043E\u043B\u0443\u044B\u04A3 \u043A\u0435\u0440\u0435\u043A "
  - "\u0421\u044B\u0440\u0442\u0442\u0430 \u0441\u0435\u043D \u04AF\u0448\u0456\u043D
    \u049B\u0430\u0443\u0456\u043F\u0442\u0456"
  - "\u0411\u04AF\u0433\u0456\u043D \u043C\u0443\u0437\u044B\u043A\u0430 \u043C\u0435\u0440\u0435\u043A\u0435\u0441\u0456
    (\u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u0456) \u0431\u043E\u043B\u044B\u043F
    \u0436\u0430\u0442\u049B\u0430\u043D \u0441\u0438\u044F\u049B\u0442\u044B\u2026
    2 \u0436\u044B\u043B\u0434\u0430 1 \u0440\u0435\u0442 \u049B\u0430\u043D\u0430
    \u0431\u043E\u043B\u0430\u0442\u044B\u043D \u043C\u0435\u0440\u0435\u043A\u0435
    \u0493\u043E\u0439, \u0431\u04AF\u0433\u0456\u043D \u0431\u0430\u0440\u043C\u0430\u0441\u0430\u043C
    \u043E\u043B "
  - "\u0416\u0435\u0442\u043A\u0456\u043B\u0456\u043A\u0442\u0456!!! \u041C\u0435\u043D
    \u0441\u0430\u0493\u0430\u043D \u043C\u0443\u0437\u044B\u043A\u0430\u0493\u0430
    \u0430\u0440\u0430\u043B\u0430\u0441\u043F\u0430 \u0434\u0435\u0434\u0456\u043C
    \u0493\u043E\u0439. \u0421\u0435\u043D\u0456\u04A3 \u0430\u043D\u0430\u04A3 \u0434\u0430
    \u043C\u0443\u0437\u044B\u043A\u0430\u043C\u0435\u043D \u0430\u0440\u0430\u043B\u0430\u0441\u049B\u0430\u043D\u0434\u0430
    \u043E\u0441\u044B\u043D\u0434\u0430\u0439 \u0431\u043E\u043B\u0493\u0430\u043D. "
  - "(\u049A\u043E\u0440\u049B\u044B\u043D\u044B\u0448 \u0431\u043E\u043B\u0441\u0430
    \u0434\u0430, \u0431\u04AF\u0433\u0456\u043D \u0431\u043E\u043B\u043C\u0430\u0441\u0430\u2026)
    \u041E\u0441\u044B \u0436\u043E\u043B\u044B \u0431\u0430\u0440\u043C\u0430\u0441\u0430\u043C,
    \u0431\u0430\u0441\u049B\u0430 \u043C\u04AF\u043C\u043A\u0456\u043D\u0434\u0456\u043A
    \u0431\u043E\u043B\u043C\u0430\u0439\u0442\u044B\u043D \u0441\u0438\u044F\u049B\u0442\u044B"
  - "\u0416\u0430\u043B\u044B\u043D\u0430\u043C\u044B\u043D, \u0436\u0430\u049B\u044B\u043D\u0434\u0430\u2026
    \u0431\u04B1\u043B \u04D9\u043B\u0435\u043C\u0434\u0435 \u043C\u04AF\u043B\u0434\u0435\u043C
    \u0436\u043E\u049B \u0431\u043E\u043B\u0430\u0442\u044B\u043D \u0441\u0438\u044F\u049B\u0442\u044B"
  - "\u042D\u0445.. \u0422\u04AF\u04AF\u04AF\u0439 "
  - "\u041C\u0430\u0493\u0430\u043D \u0430\u043D\u0434\u0430\u0493\u044B\u0434\u0430\u0439
    \u043C\u0456\u043D\u0435\u0437 \u043A\u04E9\u0440\u0441\u0435\u0442\u043F\u0435!"
  - "\u0421\u0435\u043D \u04E9\u043C\u0456\u0440 \u0431\u043E\u0439\u044B \u043E\u0441\u044B\u043D\u0434\u0430
    \u0431\u043E\u043B\u0430\u0441\u044B\u04A3! "
  - "\u042D\u0445\u2026 \u044D\u0445\u2026 \u041A\u0435\u0448\u0435 \u0431\u0456\u0440\u0430\u0437
    \u0436\u0430\u049B\u0441\u0430\u0440\u044B\u043F \u049B\u0430\u043B\u0493\u0430\u043D
    \u0441\u0438\u044F\u049B\u0442\u044B \u0435\u0434\u0456 "
  - "(\u04D8\u043A\u0435\u043C \u0431\u0430\u0441\u049B\u0430\u0448\u0430 \u0430\u0439\u0442\u0441\u0430
    \u0434\u0430\u2026 \u0431\u04AF\u0433\u0456\u043D \u0431\u0430\u0440\u043C\u0430\u0441\u0430\u043C
    \u049B\u0430\u0448\u0430\u043D) \u0415\u0441\u0456\u043A\u0442\u0435\u0433\u0456
    \u049B\u04B1\u043B\u044B\u043F\u0442\u044B \u0442\u0435\u043A\u0441\u0435\u0440\u0456\u043F
    \u043A\u04E9\u0440\u0435\u0439\u0456\u043D "
  - "\u049A\u04B1\u043B\u044B\u043F\u0442\u044B\u04A3 \u0456\u0448\u0456\u043D\u0434\u0435
    \u0431\u0456\u0440\u043D\u04D9\u0440\u0441\u0435\u043C\u0435\u043D \u0448\u04B1\u049B\u044B\u043B\u0430\u0441\u0430,
    \u0430\u0448\u044B\u043B\u0430\u0442\u044B\u043D \u0441\u0438\u044F\u049B\u0442\u044B\u2026"
  - "\u0410\u0430\u0430 \u0448\u0430\u0448 \u049B\u044B\u0441\u0442\u044B\u0440\u0493\u044B\u0448\u044B\u043C\u043C\u0435\u043D
    \u0430\u0448\u0443\u0493\u0430 \u0431\u043E\u043B\u0430\u0442\u044B\u043D \u0441\u0438\u044F\u049B\u0442\u044B "
  - "\u049A\u0430\u043D\u0435, \u043A\u04E9\u0440\u0435\u0439\u0456\u043A\u2026! "
