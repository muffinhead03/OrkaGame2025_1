--- !u!114 &393945454
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 393945453}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd692f03de89c764ca2307ecbca64a28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  KoreanAbove1_2:
  - "\uC5D0\uCF54"
  - "\uC544\uBE60"
  EnglishAbove1_2:
  - Echo
  - Dad
  JapaneseAbove1_2:
  - 
  - 
  ChineseAbove1_2: []
  KazaAbove1_2: []
  KoreanLines1_2:
  - "\uC544\uBE60..."
  - "\uC57C \uC544\uCE68\uC774\uB2E4!"
  - "\uC544\uBE60 \uC624\uB298\uB9CC \uD639\uC2DC \uBC16\uC5D0 \uB098\uAC00\uB3C4
    \uB420\uAE4C\uC694...?"
  - "\uBB34\uC2A8 \uC18C\uB9AC\uB2C8? \uB108\uB294 \uC5EC\uAE30 \uC788\uC5B4\uC57C\uB9CC
    \uD574"
  - "\uBC16\uC740 \uB108\uC5D0\uAC8C \uC704\uD5D8\uD558\uB2E8\uB2E4"
  - "\uC624\uB298 \uBC16\uC5D0\uC11C \uC74C\uC545 \uCD95\uC81C\uB97C \uD558\uB294
    \uAC83 \uAC19\uC740\uB370...2\uB144\uC5D0 1\uBC88 \uC5F4\uB9AC\uB294 \uCD95\uC81C\uB77C
    \uC624\uB298\uC774 \uC544\uB2C8\uBA74 \uADF8"
  - "\uC57C!!! \uC74C\uC545 \uC18C\uB9AC \uD558\uC9C0 \uB9D0\uB7AC\uC9C0 \uB108\uB124
    \uC5C4\uB9C8\uB3C4 \uC74C\uC545\uD558\uB2E4\uAC00 \uADF8 \uAF34 \uB0AC\uB294\uB370"
  - "(\uBB34\uC11C\uC6CC \uD558\uC9C0\uB9CC \uC624\uB298\uC774 \uC544\uB2C8\uBA74...)
    \uC774\uBC88\uC5D0 \uBABB\uAC00\uBA74 \uB2E4\uC2DC\uB294 \uAC08 \uAE30\uD68C\uAC00
    \uC5C6\uC744 \uAC83 \uAC19\uC544\uC694"
  - "\uBD80\uD0C1\uC774\uC5D0\uC694 \uC81C\uBC1C \uC800\uB294 \uACE7... \uC774 \uC138\uC0C1\uC5D0
    \uC5C6\uC744 \uAC83 \uAC19\uB2E4\uACE0\uC694"
  - "\uD5C8..\uC5B5.."
  - "\uADF8\uB534 \uC18C\uB9AC \uB0B4\uAC00 \uD558\uC9C0 \uB9D0\uB7AC\uC9C0! "
  - "\uB10C \uD3C9\uC0DD \uC55E\uC73C\uB85C\uB3C4 \uC601\uC6D0\uD788 \uC5EC\uAE30\uC5D0
    \uC788\uB294\uAC70\uC57C!"
  - "(............., ........, .............) \uD558\uC544....\uD558\uC544..\uC774\uC81C
    \uC880 \uAD1C\uCC2E\uC544\uC9C4 \uAC83 \uAC19\uC544...."
  - "(\uC544\uBE60\uB294 \uC800\uB807\uAC8C \uB9D0\uC500\uD558\uC168\uC9C0\uB9CC...\uC624\uB298\uC774
    \uC544\uB2C8\uBA74 \uC548\uB3FC) \uBB38 \uC7A0\uAE08\uC7A5\uCE58\uB97C \uC0B4\uD3B4\uBCF4\uC790"
  - "\uC548\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uC464\uC154 \uB123\uC73C\uBA74 \uC7A0\uAE08\uC7A5\uCE58\uAC00
    \uC5F4\uB9B4 \uAC83 \uAC19\uC740\uB370..."
  - "\uC544 \uB0B4 \uBA38\uB9AC\uD540\uC73C\uB85C \uD558\uBA74 \uC5F4\uB9B4 \uAC83
    \uAC19\uC544 "
  - "\uD55C\uBC88 \uD574\uBCF4\uC790...!"
  EnglishLines1_2:
  - "Dad\u2026"
  - "Get up! It\u2019s morning!"
  - "Dad, is it okay if I go out today\u2026? Just for today\u2026?"
  - What are you talking about? You must stay here
  - The outside world is dangerous for you
  - "There\u2019s a music festival going on today\u2026 It\u2019s only held once
    every two years\u2026 so if I miss it today\u2026"
  - Hey!!! I told you, No Music! Your mom got messed up because of it!
  - "(I\u2019m scared\u2026 but if not today\u2026) I might never get another chance
    if\u2026"
  - "Please\u2026 I\u2019m begging you\u2026 I really\u2026 feel like I won\u2019t
    be in this world much longer\u2026"
  - "HAh\u2014!\u2026"
  - I told you, no more of that crap!
  - "You\u2019re staying here for life, no matter what!"
  - "(............., ........, .............) Hah\u2026 hah\u2026 I guess I\u2019m
    okay now\u2026"
  - "(Even though Dad said so\u2026 today is the only day) I should check the lock
    on the door"
  - "Maybe if I stick something in there, the lock might open\u2026"
  - "Okay\u2026 let\u2019s try\u2026!"
  - Oh, I think I can use my hairpin to open it
  JapaneseLines1_2: []
  ChineseLines1_2: []
  KazaLines1_2: []
