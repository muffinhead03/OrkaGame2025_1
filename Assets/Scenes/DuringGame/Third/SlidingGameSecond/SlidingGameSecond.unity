    \uACF5\uAC04\uC73C\uB85C \uD0C0\uC77C\uC774 \uC6C0\uC9C1\uC77C \uAC70\uC57C"
  - "\uBA3C\uC800 \uC5F4\uC1E0 \uADF8\uB9BC\uC744 \uB9DE\uCDB0\uC11C \uB9AC\uBCF8\uC744
    \uC5BB\uC790"
  - "\uADF8 \uB2E4\uC74C\uC5D0 \uC790\uBB3C\uC1E0\uB97C \uB9DE\uCD94\uACE0 \uC5F4\uC1E0\uB97C
    \uC774\uC6A9\uD574 \uC790\uBB3C\uC1E0\uB97C \uD478\uB294 \uAC70\uC57C"
  - "\uC790\uBB3C\uC1E0\uB294 \uD558\uB098\uC9C0\uB9CC..."
  - "\uC0AC\uC2AC\uC774 \uC624\uB978\uCABD\uACFC \uC67C\uCABD\uC5D0 \uBAA8\uB450\uC5D0
    \uC5F0\uACB0\uB418\uC5B4 \uC788\uC5C8\uC744 \uAC70\uC57C"
  - "\uBA3C\uC800 \uC624\uB978\uCABD \uC0AC\uC2AC\uC774 \uC790\uBB3C\uC1E0\uC640
    \uC5F0\uACB0\uB418\uAC8C \uB9CC\uB4E4\uACE0 \uC5F4\uC1E0\uB97C \uB3CC\uB9AC\uC790"
  - "\uADF8 \uB2E4\uC74C\uC5D0 \uC67C\uCABD \uC0AC\uC2AC\uC774 \uC790\uBB3C\uC1E0\uC640
    \uC5F0\uACB0\uB418\uAC8C \uB9CC\uB4E4\uACE0 \uC5F4\uC1E0\uB97C \uB3CC\uB9AC\uB294
    \uAC70\uC57C"
  - "\uC54C\uACA0\uC9C0? \uC5F4\uC1E0\uB97C \uCD1D 2\uBC88 \uB3CC\uB824\uC57C \uD574"
  - "\uC5B4\uC11C \uC9D1\uC5D0 \uB3CC\uC544\uAC00\uC790. \uB354 \uC774\uC0C1 \uC5EC\uAE30
    \uC788\uACE0 \uC2F6\uC9C0 \uC54A\uC544..\r\n"
  englishLines:
  - "This door looks similar to the one I saw in my room\u2026"
  - I just have to move the tiles to match the key and lock images
  - "If I click a tile with the mouse, it\u2019ll move into the empty space"
  - "First, let\u2019s match the key image and get the ribbon"
  - Then, match the lock image and use the key to open it
  - "There\u2019s just one lock,"
  - but the chains were probably connected on both the right and left sides of the
    lock
  - "Let\u2019s connect the right chain to the lock first, and then turn the key"
  - After that, connect the left chain to the lock and turn the key
  - After that, connect the left chain to the lock and turn the key
  - I need to turn the key twice in total
  - "Let\u2019s go back home quickly. I don\u2019t want to stay here any longer\u2026"
  japaneseLines:
  - "\u30A2\u30BF\u30B7\u306E\u90E8\u5C4B\u306B\u3042\u308B\u30C9\u30A2\u3068\u4F3C\u3066\u308B\u306E\u2026"
  - "\u30BF\u30A4\u30EB\u3092\u52D5\u304B\u3057\u3066\u3001\u30AB\u30AE\u3068\u9320\u306E\u30A4\u30E1\u30FC\u30B8\u3092\u5408\u308F\u305B\u308C\u3070\u3044\u3044\u306E\u2026"
  - "\u30DE\u30A6\u30B9\u3067\u30BF\u30A4\u30EB\u3092\u30AF\u30EA\u30C3\u30AF\u3059\u308B\u3068\u3001\u7A7A\u3044\u3066\u308B\u3068\u3053\u308D\u306B\u30BF\u30A4\u30EB\u304C\u52D5\u304F\u306E"
  - "\u307E\u305A\u306F\u30AB\u30AE\u306E\u30A4\u30E1\u30FC\u30B8\u3092\u5408\u308F\u305B\u3066\u3001\u30EA\u30DC\u30F3\u3092\u624B\u306B\u5165\u308C\u3088\u3046"
  - "\u305D\u308C\u304B\u3089\u9320\u306E\u30A4\u30E1\u30FC\u30B8\u3092\u5408\u308F\u305B\u3066\u3001\u30AB\u30AE\u3092\u4F7F\u3063\u3066\u9320\u3092\u958B\u3051\u3088\u3046"
  - "\u9320\u306F\u3072\u3068\u3064\u3057\u304B\u306A\u3044\u3051\u3069\u2026"
  - "\u9396\u306F\u53F3\u3068\u5DE6\u3001\u4E21\u65B9\u306B\u3064\u306A\u304C\u3063\u3066\u305F\u306F\u305A"
  - "\u307E\u305A\u306F\u53F3\u306E\u9396\u3092\u9320\u306B\u3064\u306A\u304C\u308B\u3088\u3046\u306B\u3057\u3066\u2026\u30AB\u30AE\u3092\u56DE\u305D\u3046"
  - "\u307E\u305A\u306F\u53F3\u306E\u9396\u3092\u9320\u306B\u3064\u306A\u304C\u308B\u3088\u3046\u306B\u3057\u3066\u2026\u30AB\u30AE\u3092\u56DE\u305D\u3046"
  - "\u305D\u308C\u304B\u3089\u5DE6\u306E\u9396\u3092\u9320\u306B\u3064\u306A\u304C\u308B\u3088\u3046\u306B\u3057\u3066\u2026\u30AB\u30AE\u3092\u56DE\u305D\u3046"
  - "\u308F\u304B\u3063\u305F\uFF1F\u30AB\u30AE\u3092\u4E8C\u5EA6\u307E\u308F\u3059\u306E\u3088\u2026!"
  - "\u65E9\u304F\u3046\u3061\u306B\u5E30\u308D\u3046\u2026\u2026\u3082\u3046\u3053\u3053\u306B\u306F\u3044\u305F\u304F\u306A\u3044\u306E\u2026"
  chineseLines:
  - "\u8FD9\u6247\u95E8\uFF0C\u597D\u50CF\u6211\u623F\u95F4\u91CC\u7684\u90A3\u6247\u2026\u2026"
  - "\u628A\u62FC\u56FE\u79FB\u52A8\u4E00\u4E0B\uFF0C\u5BF9\u9F50\u94A5\u5319\u548C\u9501\u7684\u56FE\u6848\u5C31\u884C\u4E86\u3002"
  - "\u7528\u9F20\u6807\u70B9\u51FB\u62FC\u56FE\uFF0C\u5B83\u5C31\u4F1A\u79FB\u52A8\u5230\u7A7A\u767D\u5904\u3002"
  - "\u5148\u62FC\u51FA\u94A5\u5319\u56FE\u6848\uFF0C\u62FF\u5230\u4E1D\u5E26\u3002"
  - "\u7136\u540E\u62FC\u51FA\u9501\u56FE\u6848\uFF0C\u7528\u94A5\u5319\u6253\u5F00\u5B83\u3002"
  - "\u867D\u7136\u53EA\u6709\u4E00\u4E2A\u9501\u2026\u2026"
  - "\u4F46\u9501\u7684\u4E24\u8FB9\u5E94\u8BE5\u90FD\u8FDE\u63A5\u7740\u94FE\u6761\u3002"
  - "\u5148\u8BA9\u53F3\u8FB9\u7684\u94FE\u6761\u5BF9\u51C6\u9501\uFF0C\u518D\u8F6C\u52A8\u94A5\u5319\u3002"
  - "\u7136\u540E\u518D\u8BA9\u5DE6\u8FB9\u7684\u94FE\u6761\u5BF9\u51C6\u9501\uFF0C\u518D\u8F6C\u4E00\u6B21\u94A5\u5319\u3002"
  - "\u660E\u767D\u4E86\u5417\uFF1F\u94A5\u5319\u8981\u8F6C\u4E24\u6B21\u54E6\u3002"
  - "\u5FEB\u56DE\u5BB6\u5427\u2026\u2026\u6211\u4E0D\u60F3\u518D\u5F85\u5728\u8FD9\u91CC\u4E86\u2026\u2026"
  kazakhLines:
  - "\u041C\u0435\u043D\u0456\u04A3 \u0431\u04E9\u043B\u043C\u0435\u043C\u0434\u0435\u0433\u0456
    \u0435\u0441\u0456\u043A\u043A\u0435 \u04B1\u049B\u0441\u0430\u0439\u0434\u044B\u2026!"
  - "\u0422\u0430\u049B\u0442\u0430\u0448\u0430\u043D\u044B \u049B\u043E\u0437\u0493\u0430\u043B\u0442\u044B\u043F,
    \u049B\u04B1\u043B\u044B\u043F \u043F\u0435\u043D \u043A\u0456\u043B\u0442\u0442\u0456
    \u0441\u04D9\u0439\u043A\u0435\u0441\u0442\u0435\u043D\u0434\u0456\u0440\u0443
    \u043A\u0435\u0440\u0435\u043A"
  - "\u0422\u0430\u049B\u0442\u0430\u0448\u0430\u0493\u0430 \u0442\u044B\u0448\u049B\u0430\u043D\u043C\u0435\u043D
    \u0431\u0430\u0441\u0441\u0430\u04A3, \u0431\u043E\u0441 \u043E\u0440\u044B\u043D\u0493\u0430
    \u049B\u043E\u0437\u0493\u0430\u043B\u0430\u0434\u044B"
  - "\u0411\u0456\u0440\u0456\u043D\u0448\u0456, \u0441\u0443\u0440\u0435\u0442\u0442\u0435\u0440\u0434\u0456
    \u0441\u04D9\u0439\u043A\u0435\u0441\u0442\u0435\u043D\u0434\u0456\u0440\u0456\u043F,
    \u0442\u0430\u0441\u043F\u0430\u043D\u044B \u0430\u043B\u0430\u0439\u044B\u049B"
  - "\u041E\u0441\u044B\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D, \u049B\u04B1\u043B\u044B\u043F\u0442\u044B
    \u0441\u04D9\u0439\u043A\u0435\u0441\u0442\u0435\u043D\u0434\u0456\u0440\u0456\u043F,
    \u043A\u0456\u043B\u0442\u043F\u0435\u043D \u0430\u0448\u0430\u043C\u044B\u0437"
  - "\u0421\u043E\u043D\u0434\u0430 \u0434\u0430 \u0431\u04B1\u043B \u0436\u0435\u0440\u0434\u0435
    \u0431\u0456\u0440 \u049B\u04B1\u043B\u044B\u043F\u2026"
  - "\u0428\u0430\u043D\u0436\u044B\u0440 \u0431\u0430\u0440\u043B\u044B\u049B \u043E\u04A3
    \u0436\u04D9\u043D\u0435 \u0441\u043E\u043B \u0436\u0430\u049B\u0442\u0430\u0440\u0434\u0430\u043D
    \u049B\u043E\u0441\u044B\u043B\u0430\u0434\u044B"
  - "\u0411\u0456\u0440\u0456\u043D\u0448\u0456, \u043E\u04A3 \u0436\u0430\u049B
    \u0448\u0430\u043D\u0436\u044B\u0440 \u043F\u0435\u043D \u049B\u04B1\u043B\u044B\u043F\u0442\u044B
    \u049B\u043E\u0441\u0443 \u04AF\u0448\u0456\u043D \u043A\u0456\u043B\u0442\u0442\u0456
    \u0430\u0439\u043D\u0430\u043B\u0434\u044B\u0440\u0430\u0439\u044B\u049B"
  - "\u041E\u0441\u044B\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D, \u0441\u043E\u043B
    \u0436\u0430\u049B \u0448\u0430\u043D\u0436\u044B\u0440 \u043F\u0435\u043D \u049B\u04B1\u043B\u044B\u043F\u0442\u044B
    \u049B\u043E\u0441\u0443 \u04AF\u0448\u0456\u043D \u043A\u0456\u043B\u0442\u0442\u0456
    \u0430\u0439\u043D\u0430\u043B\u0434\u044B\u0440\u0430\u043C\u044B\u0437"
  - "\u0422\u04AF\u0441\u0456\u043D\u0434\u0456\u04A3 \u0493\u043E\u0439? \u0411\u0430\u0440\u043B\u044B\u0493\u044B
    \u043A\u0456\u043B\u0442\u0442\u0456 2 \u0440\u0435\u0442 \u0430\u0439\u043D\u0430\u043B\u0434\u044B\u0440\u0443
    \u043A\u0435\u0440\u0435\u043A"
  - "\u0422\u0435\u0437\u0456\u0440\u0435\u043A \u04AF\u0439\u0433\u0435 \u043E\u0440\u0430\u043B\u0430\u0439\u044B\u049B.
    \u041C\u044B\u043D\u0430 \u0436\u0435\u0440\u0434\u0435\u0433\u0456 \u043A\u04E9\u0431\u0456\u0440\u0435\u043A
    \u0431\u0456\u0440\u0442\u04AF\u0440\u043B\u0456 \u0437\u0430\u0442\u0442\u0430\u0440\u0434\u044B\u04A3
    \u0431\u043E\u043B\u0493\u0430\u043D\u044B\u043D \u049B\u0430\u043B\u0430\u043C\u0430\u0439\u043C\u044B\u043D"
